# Default local and branch preview builds remain noindex.
DEPLOYMENT_ENV=preview
# Set only after the actual stable Pages project hostname serves valid HTTPS.
SITE_URL=
SITE_ORIGIN_VERIFIED=false
# Owner-approved existing kailor EmailJS browser-public identifiers, never provider private keys.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
