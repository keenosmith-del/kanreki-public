/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-JSONLD_HASH'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sign-in
  X-Robots-Tag: noindex, follow
/create-account
  X-Robots-Tag: noindex, follow
/privacy
  X-Robots-Tag: noindex, follow
/terms
  X-Robots-Tag: noindex, follow
/cookies
  X-Robots-Tag: noindex, follow
