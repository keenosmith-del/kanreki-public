{
  "name": "kanreki-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node --import tsx scripts/build.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:build": "node scripts/check-build.mjs",
    "film:assets": "node film/validate-revision-05-assets.mjs",
    "film:stills": "node film/render-revision-05.mjs stills",
    "film:proof": "node --experimental-strip-types film/render-revision-05.mjs proof",
    "film:master": "node film/render-revision-05.mjs video",
    "film:export": "node film/export-revision-05.mjs",
    "film:review": "node film/review.mjs",
    "film:activate": "node film/integrate-revision-05.mjs",
    "film:local": "node film/local.mjs",
    "film:opening": "node film/render.mjs opening",
    "film:interface": "node film/render.mjs interface",
    "film:preview": "node film/render.mjs local",
    "film:revision02": "node film/render-revision-02.mjs all",
    "film:export:revision02": "node film/export-revision-02.mjs",
    "film:review:local": "node film/serve-review.mjs",
    "film:revision03": "node film/render-revision-03.mjs all",
    "film:export:revision03": "node film/export-revision-03.mjs",
    "film:integrate:revision03": "node film/integrate-revision-03.mjs",
    "film:typecheck": "tsc --noEmit -p film/tsconfig.json",
    "film:revision04": "node film/render-revision-04.mjs all",
    "film:export:revision04": "node film/export-revision-04.mjs",
    "film:integrate:revision04": "node film/integrate-revision-04.mjs",
    "film:video2:proof": "node film/render-video-02.mjs proof",
    "film:video2": "node film/render-video-02.mjs all",
    "film:video2:export": "node film/export-video-02.mjs",
    "film:video2:integrate": "node film/integrate-video-02.mjs",
    "film:revision05": "node --experimental-strip-types film/render-revision-05.mjs all",
    "film:proof:revision05": "node --experimental-strip-types film/render-revision-05.mjs proof",
    "film:export:revision05": "node film/export-revision-05.mjs",
    "film:integrate:revision05": "node film/integrate-revision-05.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
